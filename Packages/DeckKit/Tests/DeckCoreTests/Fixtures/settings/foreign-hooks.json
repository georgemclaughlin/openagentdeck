{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "~/bin/audit-tool-use.sh" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "~/bin/notify-start.sh" }]
      }
    ]
  },
  "permissions": { "allow": ["Read(**)"] },
  "model": "claude-opus-5"
}
